{
  "name": "fractals",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 1111",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "build": "next build",
    "export": "pnpm build",
    "start": "next start -p 1111",
    "lint": "biome lint .",
    "analyze": "cross-env ANALYZE=true next build",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "next": "^15.5.24",
    "react": "18.2.0",
    "react-cool-dimensions": "^2.0.7",
    "react-dat-gui": "^4.1.1",
    "react-dom": "18.2.0",
    "react-markdown": "^8.0.3",
    "rehype-highlight": "^5.0.2",
    "rehype-katex": "^6.0.2",
    "rehype-raw": "^6.1.1",
    "remark-math": "^5.1.1",
    "highlight.js": "^11.11.1",
    "react-color": "^2.19.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.5.24",
    "@types/node": "18.7.20",
    "@types/prismjs": "^1.26.0",
    "@types/react": "18.0.21",
    "@types/react-dom": "18.0.6",
    "cross-env": "^7.0.3",
    "glslify-loader": "^2.0.0",
    "raw-loader": "^4.0.2",
    "typescript": "^5.9.3",
    "@biomejs/biome": "^2.4.13",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "pnpm": {
    "overrides": {
      "lodash.set": "file:vendor/lodash-set",
      "postcss@8": "8.5.28",
      "ws@7": "7.5.11"
    }
  }
}
